<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <!-- Compact single-row landscape top bar (38dp) with compact state &amp; streaming badge in between -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="14dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="40dp"
            android:layout_height="34dp"
            android:contentDescription="@string/cd_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/studio_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="•"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:maxLines="1"
            android:maxWidth="140dp"
            android:text="@string/studio_ready"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_round_btn" />

            <TextView
                android:id="@+id/stateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="@string/studio_ready"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/draftBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingLeft="6dp"
                android:paddingTop="1dp"
                android:paddingRight="6dp"
                android:paddingBottom="1dp"
                android:text="@string/studio_streaming"
                android:textColor="@color/record"
                android:textSize="8.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Preset Changer Button on the top right -->
        <LinearLayout
            android:id="@+id/settingsRow"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_search"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="10dp"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/settingsName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/preset_memo"
                android:textColor="@color/text_primary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/settingsSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/formatBadge"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="4dp"
                android:alpha="0.7"
                android:src="@drawable/ic_chevron" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main 2-Pane Workspace: Left = Teleprompter (larger weight 1.25), Right = DAW Console -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="100dp">

        <!-- Left Pane: Teleprompter -->
        <FrameLayout
            android:id="@+id/telePanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1.25"
            android:background="@drawable/bg_search"
            android:clipChildren="true">

            <com.example.hello.TeleprompterView
                android:id="@+id/teleView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/teleChrome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tele_chrome"
                android:orientation="vertical"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="10dp"
                    android:paddingTop="3dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/teleTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:letterSpacing="0.1"
                        android:maxLines="1"
                        android:text="@string/teleprompter"
                        android:textColor="@color/text_hint"
                        android:textSize="10sp" />

                    <!-- Icon-only teleprompter action buttons -->
                    <TextView
                        android:id="@+id/teleEditBtn"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_round_btn"
                        android:clickable="true"
                        android:contentDescription="@string/tele_edit"
                        android:drawableStart="@drawable/ic_tele_edit"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:text="@string/tele_edit"
                        android:textColor="#00000000"
                        android:textSize="0sp" />

                    <TextView
                        android:id="@+id/teleHideBtn"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/telePauseBtn"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_round_btn"
                        android:clickable="true"
                        android:contentDescription="@string/tele_pause"
                        android:drawableStart="@drawable/ic_tele_play"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:text="@string/tele_resume_short"
                        android:textColor="#00000000"
                        android:textSize="0sp" />

                    <TextView
                        android:id="@+id/teleMirrorBtn"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_round_btn"
                        android:clickable="true"
                        android:contentDescription="@string/tele_mirror"
                        android:drawableStart="@drawable/ic_tele_mirror"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:text="@string/tele_mirror_short"
                        android:textColor="#00000000"
                        android:textSize="0sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/teleControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp">

                    <com.example.hello.TeleValue
                        android:id="@+id/teleSizeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />

                    <com.example.hello.TeleValue
                        android:id="@+id/teleSpeedValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1" />

                    <com.example.hello.TeleValue
                        android:id="@+id/teleWplValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Pro Effects Rack Panel -->
        <LinearLayout
            android:id="@+id/fxPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1.25"
            android:background="@drawable/bg_search"
            android:clipChildren="true"
            android:minHeight="150dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fxTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="Effects Rack"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/fxPresetDropdown"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Preset: Voice Polish ▾"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/fxCloseBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_round_btn"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Close"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/fxScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/fxListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fxPreviewBtn"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_ghost"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="▶ Preview FX"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/fxApplyBtn"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Apply to Selection"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Pane: DAW Console (dB Meter | Waveform + Editor Strip + Timer) -->
        <LinearLayout
            android:id="@+id/recStrip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.hello.DbMeterView
                android:id="@+id/dbMeter"
                android:layout_width="8dp"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <!-- Waveform + Zoom Rail -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.example.hello.WaveformView
                        android:id="@+id/waveform"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.example.hello.TeleValue
                            android:id="@+id/zoomValue"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Non-Linear Editor &amp; FX Console with Icons -->
                <HorizontalScrollView
                    android:id="@+id/editorStrip"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnPreviewPlay"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_chip"
                            android:drawableStart="@drawable/ic_edit_replace"
                            android:drawablePadding="5dp"
                            android:gravity="center"
                            android:paddingLeft="10dp"
                            android:paddingRight="11dp"
                            android:text="Replace"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnSelectRange"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip"
                            android:drawableStart="@drawable/ic_edit_select"
                            android:drawablePadding="5dp"
                            android:gravity="center"
                            android:paddingLeft="10dp"
                            android:paddingRight="11dp"
                            android:text="Select"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnReplaceSeg"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip"
                            android:drawableStart="@drawable/ic_edit_select_replace"
                            android:drawablePadding="5dp"
                            android:gravity="center"
                            android:paddingLeft="10dp"
                            android:paddingRight="11dp"
                            android:text="Select &amp; Replace"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnTrimCrop"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip"
                            android:drawableStart="@drawable/ic_edit_trim"
                            android:drawablePadding="5dp"
                            android:gravity="center"
                            android:paddingLeft="10dp"
                            android:paddingRight="11dp"
                            android:text="Trim"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnCutDelete"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btnDspFx"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip"
                            android:drawableStart="@drawable/ic_edit_fx"
                            android:drawablePadding="5dp"
                            android:gravity="center"
                            android:paddingLeft="10dp"
                            android:paddingRight="11dp"
                            android:text="FX"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnEditUndo"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_chip"
                            android:drawableStart="@drawable/ic_edit_undo"
                            android:drawablePadding="5dp"
                            android:gravity="center"
                            android:paddingLeft="10dp"
                            android:paddingRight="11dp"
                            android:text="Undo"
                            android:textColor="@color/text_hint"
                            android:textSize="11sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Timer moved down cleanly -->
                <TextView
                    android:id="@+id/timerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-light"
                    android:gravity="center"
                    android:text="00:00.00"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp" />

                <!-- Retired teleToggle kept gone for ID compatibility -->
                <LinearLayout
                    android:id="@+id/teleToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/teleToggleIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_pencil" />

                    <TextView
                        android:id="@+id/teleState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tele_show" />
                </LinearLayout>

                <!-- Hidden 0dp stub row: IDs remain for layout tests. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/takeName"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/hintText"
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
