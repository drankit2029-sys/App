        <item name="colorPrimary">@color/record</item>
        <item name="colorPrimaryVariant">@color/record_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/record</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarDividerColor">@color/bg</item>
        <item name="bottomSheetDialogTheme">@style/TakeOneBottomSheetDialog</item>
