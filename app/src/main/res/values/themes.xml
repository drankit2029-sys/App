<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TakeOne" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/record</item>
        <item name="colorPrimaryVariant">@color/record_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/record</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Retained as an alias so existing unit/device tests referencing
         Theme.HelloWorld continue to compile without changes. -->
    <style name="Theme.HelloWorld" parent="Theme.TakeOne" />

    <style name="TakeOneCenterDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/ModalAnim</item>
    </style>

    <style name="ModalAnim">
        <item name="android:windowEnterAnimation">@anim/modal_in</item>
        <item name="android:windowExitAnimation">@anim/modal_out</item>
    </style>
</resources>

