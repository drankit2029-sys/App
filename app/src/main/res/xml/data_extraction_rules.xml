<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup + device-transfer rules: same story as
     backup_rules.xml — metadata travels, raw audio stays on-device, and
     crash breadcrumbs stay on-device so a restore never replays a stale
     crash dialog or encoder downgrade. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="takes" />
        <exclude domain="file" path="takes" />
        <exclude domain="file" path="takeone-crash.txt" />
        <exclude domain="file" path="takeone-breadcrumbs.txt" />
        <exclude domain="database" path="takeone-library.db" />
        <exclude domain="sharedpref" path="takeone.xml" />
        <exclude domain="sharedpref" path="takeone_script.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="takes" />
        <exclude domain="file" path="takes" />
        <exclude domain="file" path="takeone-crash.txt" />
        <exclude domain="file" path="takeone-breadcrumbs.txt" />
        <exclude domain="database" path="takeone-library.db" />
        <exclude domain="sharedpref" path="takeone.xml" />
        <exclude domain="sharedpref" path="takeone_script.xml" />
    </device-transfer>
</data-extraction-rules>
